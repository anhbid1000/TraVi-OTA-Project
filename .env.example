# =============================================
# TraVi-OTA Environment Variables
# Copy file này thành .env rồi chỉnh sửa theo máy của bạn
# =============================================

# ==================== PostgreSQL ====================
POSTGRES_PASSWORD=...

# ==================== Spring AI - OpenAI ====================
# Lấy API Key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-real-openai-api-key-here

# Jwt secret key for signing tokens
# 256 characters minimum
JWT_SECRET_KEY=...
# Gợi ý (1200 hoặc 1500)
JWT_EXPIRATION_TIME=...

# Mail Account
MAIL_USERNAME=...
MAIL_PASSWORD=...

# Google OAuth
GOOGLE_CLIENT_ID_ENV=abc.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=abc.apps.googleusercontent.com
